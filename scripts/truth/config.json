{
  "install": "bash scripts/install.sh --check",
  "commands": {
    "build": "python3 -I scripts/validate.py --everywhere",
    "lint": "python3 -I scripts/validate.py --everywhere",
    "test": "pytest -q {paths}"
  },
  "sharedGlobs": [
    "catalog.json"
  ],
  "rootAllowlist": [
    ".github",
    ".gitignore",
    ".npmrc",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "catalog.json",
    "docs",
    "index",
    "schema",
    "scripts",
    "skills",
    "templates",
    "tests"
  ],
  "largeFileAllowlist": [],
  "language": {
    "allowGlobs": [
      "catalog.json",
      "tests/fixtures/status/**"
    ]
  },
  "sql": {
    "requireRls": false,
    "requireIdempotent": false
  },
  "generatedGlobs": [
    "catalog.json"
  ],
  "integration": "auto",
  "trunkBranch": "main",
  "repoCode": "SKL"
}
