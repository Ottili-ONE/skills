venv/

# GERMO working notes and gate logs (never committed)
.truth/

# Dependencies of the truth kit (scripts/truth/package.json). The kit skips
# them in its own integrity manifest and treats them as generated artefacts
# (scripts/truth/lib/common.mjs -> generatedGlobs), but the gate's ownership
# step counts every UNTRACKED file: without these two lines a pass that runs
# `npm install --prefix scripts/truth` (the kit asks for it) fails the gate
# with "changed file(s) outside the owned paths" for files nobody may commit.
node_modules/
package-lock.json
