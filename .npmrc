# toolchain.v1 -- see docs/adr/0001-toolchain-v1.md
# @ottili scope is served ONLY by the private registry. OTTILI_REGISTRY_URL is the
# documented override (CI / staging / air-gapped hosts); the 127.0.0.1:18873 default is
# the local Verdaccio that ships with the dev host. No fallback to the public registry
# is ever configured for the @ottili scope.
@ottili:registry=${OTTILI_REGISTRY_URL:-http://127.0.0.1:18873}
registry=https://registry.npmjs.org/

# Frozen, reproducible installs. CI and local must behave identically.
prefer-frozen-lockfile=true
resolution-mode=highest
link-workspace-packages=true
save-workspace-protocol=false
# Supply chain: no implicit lifecycle scripts from transitive dependencies.
enable-pre-post-scripts=false
strict-peer-dependencies=false
engine-strict=true
