# toolchain.v1 -- see docs/adr/0001-toolchain-v1.md
# @ottili scope is served ONLY by the private registry. OTTILI_REGISTRY_URL is the
# documented override (CI / staging / air-gapped hosts); the URL itself comes from the
# environment - npm expands ${VAR} only when it is set and never expands ${VAR:-default},
# so a default in this file would stay literal and end every install in ERR_INVALID_URL.
@ottili:registry=${OTTILI_REGISTRY_URL}
registry=https://registry.npmjs.org/

# Frozen, reproducible installs. CI and local must behave identically.
prefer-frozen-lockfile=true
resolution-mode=highest
link-workspace-packages=true
save-workspace-protocol=false
# Supply chain: no implicit lifecycle scripts from transitive dependencies.
enable-pre-post-scripts=false
strict-peer-dependencies=false
engine-strict=true
